# Python
__pycache__/
*.pyc

# Rust build artifacts
target/
**/*.d
landing/

# OS build outputs
oscortex.iso
nvme.img
iso_root/boot/kernel
iso_root/boot/libflutter_engine.so

# initramfs (auto-generated by build-iso.sh)
initramfs/

# Flutter build artifacts
apps/**/build/
apps/**/.dart_tool/
apps/**/*.dill
apps/**/.flutter-plugins
apps/**/.flutter-plugins-dependencies
apps/**/pubspec.lock

# Large binary tools (keep source, exclude binary)
tools/flutter-engine/libflutter_engine.so
tools/flutter-engine/*.zip

# Limine EFI binaries
iso_root/EFI/
iso_root/boot/limine/

# Editor / OS
.DS_Store
*.swp
*.swo
*.bak
qemu-current*.log
qemu-log.txt
serial.log
docs/goal-embedded.md
docs/goal-general-purpose.md

# Build/runtime artifacts — regenerated, never track (root-anchored)
/initramfs.tar
/vdisk.img
/qemu-pipe.*

# Scratch / debugging area — experiments only, never track (public repo)
/scratch/

# Local preview mirror of the Desktop landing page (served by .claude/launch.json)
/.preview-oscortex-desktop/

# Local agent/session data — never track
/.claude/

# Downloaded prebuilt engine artifacts (fetch-engine.sh cache)
/.engine-cache/
