# OSCortex prebuilt engine artifact — pin + distribution config.
#
# These are the engine binaries devs DOWNLOAD instead of building. The full
# from-source build (setup-engine-build.sh + build-engine.sh) is only for
# MAINTAINERS who change engine-port/ or bump the Flutter pin; they rebuild and
# re-publish, then everyone else just fetches. (This is exactly how Flutter
# itself distributes its engine.)
#
# BUMP `ARTIFACT_VERSION` whenever engine-port/ changes or FLUTTER_REV is bumped,
# so consumers pull a fresh artifact instead of a stale cached one.

ARTIFACT_VERSION="oscortex-engine-1"

# Upstream Flutter these artifacts are built from (pinned/frozen — we do not
# track upstream). For reproducibility.
FLUTTER_VERSION="3.41.1"
FLUTTER_REV="582a0e7c5581dc0ca5f7bfd8662bb8db6f59d536"
ENGINE_HASH="cc8e596aa65130a0678cc59613ed1c5125184db4"

# Public base URL where the artifacts are hosted (Cloudflare R2 + CDN, zero-egress).
# Override at runtime with OSCORTEX_ENGINE_BASE_URL, or edit this line.
# Object layout:  $ARTIFACT_BASE_URL/$ARTIFACT_VERSION/oscortex-<arch>-<mode>.tar.gz
ARTIFACT_BASE_URL="${OSCORTEX_ENGINE_BASE_URL:-https://CHANGEME.r2.dev/oscortex-engine}"

# Artifacts published per target. Add arm64/riscv64 rows when those land.
#   oscortex-x64-release   (AOT/production)
#   oscortex-x64-debug     (JIT, for engine bring-up)
