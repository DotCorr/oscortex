# OSCortex prebuilt engine artifact — pin + distribution config.
#
# These are the engine binaries devs DOWNLOAD instead of building. The full
# from-source build (setup-engine-build.sh + build-engine.sh) is only for
# MAINTAINERS who change engine-port/ or bump the Flutter pin; they rebuild and
# re-publish, then everyone else just fetches. (This is exactly how Flutter
# itself distributes its engine.)
#
# BUMP `ARTIFACT_VERSION` whenever engine-port/ changes or FLUTTER_REV is bumped,
# so consumers pull a fresh artifact instead of a stale cached one.

ARTIFACT_VERSION="oscortex-engine-1"

# Upstream Flutter these artifacts are built from (pinned/frozen — we do not
# track upstream). For reproducibility.
FLUTTER_VERSION="3.41.1"
FLUTTER_REV="582a0e7c5581dc0ca5f7bfd8662bb8db6f59d536"
ENGINE_HASH="cc8e596aa65130a0678cc59613ed1c5125184db4"

# Public base URL where the artifacts are hosted. GitHub Releases on the (public)
# repo: free, zero egress fees, no separate cloud account. Each ARTIFACT_VERSION
# is a release TAG; the per-target tarballs are its assets.
# Layout: $ARTIFACT_BASE_URL/$ARTIFACT_VERSION/oscortex-<arch>-<mode>.tar.gz
#   i.e. https://github.com/<repo>/releases/download/<tag>/<asset>
# Override at runtime with OSCORTEX_ENGINE_BASE_URL.
GITHUB_REPO="DotCorr/oscortex"
ARTIFACT_BASE_URL="${OSCORTEX_ENGINE_BASE_URL:-https://github.com/DotCorr/oscortex/releases/download}"

# Optional alternate hosts (not used while ARTIFACT_BASE_URL points at GitHub):
#   GCS_BUCKET="dotcorr-oscortex-engine"   # gs:// public bucket (has egress fees)

# Artifacts published per target. Add riscv64 rows when that lands.
#   oscortex-x64-release     (AOT/production, x86_64)
#   oscortex-x64-debug       (JIT, for engine bring-up, x86_64)
#   oscortex-arm64-release   (AOT/production, aarch64 — cross-built from x64 host)
#
# arm64 (aarch64) is built by engine-port/build-engine-arm64.sh:
#   out/oscortex_arm64_release/{libflutter_engine.so,gen_snapshot}  (arm64 ELF).
# Fetch with: engine-port/fetch-engine.sh arm64 release
# (fetch-engine.sh already parameterizes arch; the artifact name is
#  oscortex-arm64-release.tar.gz under the same ARTIFACT_VERSION tag.)
