diff --git a/engine/src/flutter/fml/build_config.h b/engine/src/flutter/fml/build_config.h
index aa2f0d7b..c3ee31ee 100644
--- a/engine/src/flutter/fml/build_config.h
+++ b/engine/src/flutter/fml/build_config.h
@@ -56,6 +56,15 @@
 #error Please add support for your platform in flutter/fml/build_config.h
 #endif
 
+// OSCortex native port: an ADDITIVE OS flag. OSCortex links against linux for now
+// (so FML_OS_LINUX stays defined above and supplies the libc base); FML_OS_OSCORTEX
+// only steers the few platform-backend selections we override. Gated on the
+// FLUTTER_OSCORTEX GN define (set by fml/BUILD.gn when is_oscortex).
+// See docs/native-engine-port.md.
+#if defined(FLUTTER_OSCORTEX)
+#define FML_OS_OSCORTEX 1
+#endif
+
 // For access to standard BSD features, use FML_OS_BSD instead of a
 // more specific macro.
 #if defined(FML_OS_FREEBSD) || defined(FML_OS_OPENBSD)
